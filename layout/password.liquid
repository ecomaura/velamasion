<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">{%- else -%}<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign hf = settings.heading_font | strip | replace: ' ', '+' -%}
  {%- assign bf = settings.body_font | strip | replace: ' ', '+' -%}
  <link href="https://fonts.googleapis.com/css2?family={{ hf }}:ital,wght@0,400;0,500;0,600;1,400&amp;family={{ bf }}:wght@300;400;500;600&amp;display=swap" rel="stylesheet">
  {% render 'css-variables' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'sections.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
