{%- comment -%}
  Responsive image with theme fallback.
  Params: image (image object), fallback (asset filename), alt, sizes, loading ('lazy' | 'eager')
{%- endcomment -%}
{%- assign _loading = loading | default: 'lazy' -%}
{%- assign _sizes = sizes | default: '(min-width: 960px) 50vw, 100vw' -%}
{%- if image != blank -%}
  {{ image | image_url: width: 1800 | image_tag: loading: _loading, sizes: _sizes, widths: '400, 600, 800, 1000, 1400, 1800', alt: alt }}
{%- elsif fallback != blank -%}
  <img src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" loading="{{ _loading }}">
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'media-placeholder' }}
{%- endif -%}
