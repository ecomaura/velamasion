<style>
  :root {
    --c-primary: {{ settings.color_primary }};
    --c-primary-dark: {{ settings.color_primary | color_darken: 8 }};
    --c-primary-light: {{ settings.color_primary | color_lighten: 12 }};
    --c-on-primary: {{ settings.color_primary_contrast }};
    --c-bg: {{ settings.color_bg }};
    --c-bg-alt: {{ settings.color_bg_alt }};
    --c-accent: {{ settings.color_accent }};
    --c-accent-text: {{ settings.color_accent_text }};
    --c-text: {{ settings.color_text }};
    --c-muted: {{ settings.color_muted }};
    --c-line: {{ settings.color_line }};
    --font-heading: '{{ settings.heading_font }}', Georgia, 'Times New Roman', serif;
    --font-body: '{{ settings.body_font }}', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --img-sepia: {{ settings.image_warmth }}%;
    --maxw: {{ settings.page_width }}px;
    --logo-w: {{ settings.logo_width }}px;
    --pad: clamp(20px, 5vw, 72px);
  }
</style>
