{%- comment -%} Params: product, variant (optional – overrides product pricing) {%- endcomment -%}
{%- liquid
  if variant != blank
    assign p = variant.price
    assign cp = variant.compare_at_price
    assign avail = variant.available
    assign varies = false
  else
    assign p = product.price
    assign cp = product.compare_at_price
    assign avail = product.available
    assign varies = product.price_varies
  endif
-%}
<span class="price">
  {%- if cp > p and avail -%}
    <s class="price-was">{{ cp | money }}</s>
    <span class="price-now">{{ p | money }}</span>
  {%- elsif varies -%}
    <span class="price-now"><small>From</small> {{ product.price_min | money }}</span>
  {%- else -%}
    <span class="price-now">{{ p | money }}</span>
  {%- endif -%}
</span>
