{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gift card – {{ shop.name }}</title>
  {%- assign hf = settings.heading_font | strip | replace: ' ', '+' -%}
  {%- assign bf = settings.body_font | strip | replace: ' ', '+' -%}
  <link href="https://fonts.googleapis.com/css2?family={{ hf }}:ital,wght@0,400;0,500;1,400&amp;family={{ bf }}:wght@300;400;500&amp;display=swap" rel="stylesheet">
  {% render 'css-variables' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'sections.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <main class="gc">
    <span class="logo">{{ shop.name }}</span>
    <span class="eyebrow">Gift card</span>
    <h1>{{ gift_card.initial_value | money }}</h1>
    {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-msg form-msg--error">This gift card is {% if gift_card.expired %}expired{% else %}disabled{% endif %}.</p>{%- endif -%}
    <p class="muted" style="margin:10px auto">Remaining balance: <strong>{{ gift_card.balance | money }}</strong>{% if gift_card.expires_on %} · Expires {{ gift_card.expires_on | date: '%B %d, %Y' }}{% endif %}</p>
    <div class="gc-code">{{ gift_card.code | format_code }}</div>
    <a class="btn btn--solid" href="{{ shop.url }}">Start shopping</a>
  </main>
</body>
</html>
