<section class="section">
  <div class="container acct acct-narrow">
    <div class="center"><span class="eyebrow">Account</span><h1>Reset password</h1><p class="muted" style="margin:12px auto 28px">Choose a new password for {{ email }}.</p></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="RPass">Password</label><input id="RPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="RPass2">Confirm password</label><input id="RPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--solid btn--block" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>
