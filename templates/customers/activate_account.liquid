<section class="section">
  <div class="container acct acct-narrow">
    <div class="center"><span class="eyebrow">Account</span><h1>Activate account</h1><p class="muted" style="margin:12px auto 28px">Create a password to activate your account.</p></div>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="APass">Password</label><input id="APass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="APass2">Confirm password</label><input id="APass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--solid btn--block" type="submit">Activate account</button>
      <p style="margin-top:14px;text-align:center"><button class="line-remove" style="display:inline" type="submit" name="decline">Decline invitation</button></p>
    {%- endform -%}
  </div>
</section>
