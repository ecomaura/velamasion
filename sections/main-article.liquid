<article class="section">
  <div class="container page-narrow">
    <header class="center">
      <span class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</span>
      <h1>{{ article.title }}</h1>
    </header>
    {%- if article.image -%}
      <div class="framed article-img"><div class="media media--16x9">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 960px) 800px, 100vw', alt: article.image.alt | default: article.title }}</div></div>
    {%- endif -%}
    <div class="rte page-body">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}<div class="active-filters tag-row">{%- for tag in article.tags -%}<a class="chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}</div>{%- endif -%}
    <p class="center" style="margin-top:40px"><a class="link-arrow" href="{{ blog.url }}">Back to {{ blog.title }}</a></p>
  </div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
