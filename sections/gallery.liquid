<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section-head"><div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div></div>
    <div class="mag">
      {%- for block in section.blocks -%}
        <div class="mag-item media zoom" {{ block.shopify_attributes }}>
          {% render 'media', image: block.settings.image, alt: block.settings.alt, sizes: '(min-width: 960px) 50vw, 100vw' %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the home" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create your own atmosphere." },
    { "type": "select", "id": "bg", "label": "Background", "default": "ivory", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" } ] }
  ],
  "blocks": [
    {
      "type": "image", "name": "Image", "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Image description" }
      ]
    }
  ],
  "presets": [{ "name": "Editorial gallery", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
