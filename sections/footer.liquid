<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div>
        <a class="logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
        {%- if section.settings.about != blank -%}<p class="footer-about">{{ section.settings.about }}</p>{%- endif -%}
        <div class="social">
          {%- if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>{% endif -%}
          {%- if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a>{% endif -%}
          {%- if settings.social_pinterest != blank %}<a href="{{ settings.social_pinterest }}" rel="noopener" target="_blank">Pinterest</a>{% endif -%}
          {%- if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a>{% endif -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>{%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="footer-base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{%- for link in linklists['footer'].links -%}{{ link.title | link_to: link.url }}{% unless forloop.last %} &middot; {% endunless %}{%- endfor -%}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "default": "Candles for the moments that matter." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link list",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
