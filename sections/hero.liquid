{%- assign full = false -%}
{%- if section.settings.layout == 'full' %}{% assign full = true %}{% endif -%}
{%- capture copy -%}
  {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  <h1>{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  <div class="hero-btns">
    {%- if section.settings.button_label != blank -%}<a class="btn {% if full %}btn--gold{% else %}btn--solid{% endif %}" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>{%- endif -%}
    {%- if section.settings.button2_label != blank -%}<a class="btn {% if full %}btn--light{% endif %}" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>{%- endif -%}
  </div>
{%- endcapture -%}
{%- capture hero_img -%}{% render 'media', image: section.settings.image, alt: section.settings.image_alt, loading: 'eager', sizes: '(min-width: 960px) 50vw, 100vw' %}{%- endcapture -%}

{%- if full -%}
<section class="hero hero--full">
  <div class="hero-bg media">{{ hero_img }}</div>
  <div class="hero-inner container"><div class="hero-copy">{{ copy }}</div></div>
</section>
{%- else -%}
<section class="hero hero--split">
  <div class="hero-inner container">
    <div class="hero-copy">{{ copy }}</div>
    <div class="framed"><div class="hero-media media">{{ hero_img }}</div></div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [
      { "value": "split", "label": "Split – text on ivory, image beside" },
      { "value": "full", "label": "Full-bleed image" } ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make room for the moments that matter." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtfully crafted fragrances that transform everyday spaces into meaningful experiences." },
    { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button 1 link" },
    { "type": "text", "id": "button2_label", "label": "Button 2 label", "default": "Our story" },
    { "type": "url", "id": "button2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
