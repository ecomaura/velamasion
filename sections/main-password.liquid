<section class="pw">
  <div class="pw-inner">
    <a class="logo" href="{{ routes.root_url }}">{%- if settings.logo_footer != blank -%}{{ settings.logo_footer | image_url: width: 700 | image_tag: alt: shop.name, class: 'logo-img' }}{%- else -%}<img class="logo-img" src="{{ 'logo-full.png' | asset_url }}" alt="{{ shop.name | escape }}">{%- endif -%}</a>
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted" style="margin:18px auto 0">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', id: 'pw-signup', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}<p class="form-msg" role="status">Thank you. We'll let you know when we open.</p>{%- endif -%}
      {%- if form.errors -%}<p class="form-msg form-msg--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="newsletter-row"><input type="email" name="contact[email]" required placeholder="Your email address" aria-label="Email address"><button class="btn btn--solid" type="submit">Notify me</button></div>
    {%- endform -%}
    <details class="pw-owner">
      <summary>Store owner? Enter with password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-msg form-msg--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter-row"><input type="password" name="password" required placeholder="Password" aria-label="Password"><button class="btn" type="submit">Enter</button></div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make room for the moments that matter." }
  ]
}
{% endschema %}
