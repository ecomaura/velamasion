<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section-head"><div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div></div>
    <div class="columns" style="--cols:{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="column" {{ block.shopify_attributes }}>
          <div class="media media--3x4 zoom">{% render 'media', image: block.settings.image, alt: block.settings.title, sizes: '(min-width: 960px) 25vw, 50vw' %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image columns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Four elements" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every element tells a story." },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "bg", "label": "Background", "default": "alt", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" } ] }
  ],
  "blocks": [
    {
      "type": "column", "name": "Column", "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Air" },
        { "type": "text", "id": "text", "label": "Text", "default": "Air gives us freedom." }
      ]
    }
  ],
  "presets": [{ "name": "Image columns", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
