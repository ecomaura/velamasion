{%- assign col = section.settings.collection | default: collections.all -%}
{%- assign n = section.settings.products_count -%}
<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="link-arrow" href="{{ col.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="product-grid" style="--cols:{{ section.settings.columns }}">
      {%- if col.products.size > 0 -%}
        {%- for product in col.products limit: n -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- else -%}
        {%- for i in (1..n) -%}{% render 'product-card', product: nil %}{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Signature Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Four fragrances, each built around a feeling." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop all" },
    { "type": "select", "id": "bg", "label": "Background", "default": "ivory", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" }, { "value": "forest", "label": "Forest green" } ] }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
