<section class="section bg-{{ section.settings.bg }}">
  <div class="container split{% if section.settings.image_left %} split--flip{% endif %}">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="split-text">{{ section.settings.text }}</p>{%- endif -%}
      <nav class="fam" aria-label="Find your fragrance">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="fam-thumb media">{% render 'media', image: block.settings.image, alt: block.settings.title, sizes: '64px' %}</span>
            <span><b>{{ block.settings.title }}</b><em>{{ block.settings.subtitle }}</em></span>
            <i>Shop</i>
          </a>
        {%- endfor -%}
      </nav>
    </div>
    <figure class="framed">
      <div class="media media--4x5">{% render 'media', image: section.settings.image, alt: section.settings.caption %}</div>
      {%- if section.settings.caption != blank -%}<figcaption>{{ section.settings.caption }}</figcaption>{%- endif -%}
    </figure>
  </div>
</section>
{% schema %}
{
  "name": "Fragrance families",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your fragrance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than a fragrance. A feeling." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each candle is built around a feeling: softness, warmth, elegance, depth. Choose the atmosphere your space needs." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "checkbox", "id": "image_left", "label": "Image on the left", "default": false },
    { "type": "select", "id": "bg", "label": "Background", "default": "ivory", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" } ] }
  ],
  "blocks": [
    {
      "type": "family", "name": "Fragrance family", "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "text", "id": "title", "label": "Title", "default": "Floral & soft" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Cherry Blossom · Royal Rose" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Fragrance families", "blocks": [{ "type": "family" }, { "type": "family" }, { "type": "family" }] }]
}
{% endschema %}
