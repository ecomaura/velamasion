<section class="section cart-page">
  <div class="container">
    <h1>Your bag</h1>
    {%- if cart.item_count == 0 -%}
      <div class="empty-state"><p class="muted" style="margin-inline:auto">Your bag is empty.</p><a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">Browse the collection</a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" data-cart-form>
        <div class="cart-layout">
          <div class="cart-items">
            {%- for item in cart.items -%}
              <div class="cart-row">
                <a class="media media--4x5 zoom" href="{{ item.url }}">
                  {%- if item.image -%}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '110px', alt: item.product.title }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'media-placeholder' }}{%- endif -%}
                </a>
                <div class="cart-row-info">
                  <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {%- unless item.product.has_only_default_variant -%}<p class="variant">{{ item.variant.title }}</p>{%- endunless -%}
                  {%- for p in item.properties -%}{%- unless p.last == blank -%}<p class="variant">{{ p.first }}: {{ p.last }}</p>{%- endunless -%}{%- endfor -%}
                  {%- for d in item.line_level_discount_allocations -%}<p class="variant gold">{{ d.discount_application.title }} (−{{ d.amount | money }})</p>{%- endfor -%}
                  <div class="cart-row-ctrl">
                    <div class="qty">
                      <button type="button" data-step="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-qty-input aria-label="Quantity for {{ item.product.title | escape }}">
                      <button type="button" data-step="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <a class="line-remove" href="{{ item.url_to_remove }}">Remove</a>
                  </div>
                </div>
                <div class="cart-row-price">
                  {%- if item.original_line_price != item.final_line_price -%}<s class="price-was">{{ item.original_line_price | money }}</s><br>{%- endif -%}
                  <span class="price-now price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <aside class="cart-summary">
            <h3>Summary</h3>
            {%- for d in cart.cart_level_discount_applications -%}
              <div class="sum-row gold"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="cart-subtotal"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
            <p class="cart-note">{% if cart.taxes_included %}Tax included. {% endif %}{{ settings.cart_note_text }}</p>
            {%- if section.settings.show_note -%}
              <div class="field"><label for="CartNote">Order note</label><textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea></div>
            {%- endif -%}
            <button class="btn btn--solid btn--block" type="submit" name="checkout">Checkout</button>
            <p style="margin-top:16px;text-align:center"><a class="link-arrow" href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>
          </aside>
        </div>
        <noscript><button class="btn" type="submit" name="update">Update bag</button></noscript>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note field", "default": true }
  ]
}
{% endschema %}
