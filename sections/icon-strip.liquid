<section class="strip bg-{{ section.settings.bg }}" aria-label="Highlights">
  <div class="container strip-grid" style="--n:{{ section.blocks.size | at_least: 1 }}">
    {%- for block in section.blocks -%}
      <div class="strip-item" {{ block.shopify_attributes }}>
        <span class="strip-ico">{% render 'icon', name: block.settings.icon %}</span>
        <b>{{ block.settings.title }}</b>
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Highlights strip",
  "settings": [
    { "type": "select", "id": "bg", "label": "Background", "default": "alt", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" } ] }
  ],
  "blocks": [
    {
      "type": "item", "name": "Highlight", "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
          { "value": "leaf", "label": "Leaf" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "pin", "label": "Pin" },
          { "value": "gift", "label": "Gift box" }, { "value": "flame", "label": "Flame" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Soy wax" },
        { "type": "text", "id": "text", "label": "Text", "default": "7 oz amber jar" }
      ]
    }
  ],
  "presets": [{ "name": "Highlights strip", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
