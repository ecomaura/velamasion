{%- assign form_id = 'newsletter-' | append: section.id -%}
<section class="section bg-{{ section.settings.bg }} newsletter">
  <div class="container center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}<p class="form-msg" role="status">Thank you for subscribing.</p>{%- endif -%}
      {%- if form.errors -%}<p class="form-msg form-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="newsletter-row">
        <input type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address" aria-label="Email address" value="{{ form.email }}">
        <button class="btn btn--gold" type="submit">Subscribe</button>
      </div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little warmth in your inbox." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover new fragrances, thoughtful rituals, and moments worth slowing down for." },
    { "type": "select", "id": "bg", "label": "Background", "default": "forest", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" }, { "value": "forest", "label": "Forest green" } ] }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
