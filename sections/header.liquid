{%- assign menu = linklists[section.settings.menu] -%}
<header class="site-header site-header--{{ settings.header_style }}" data-header>
  <div class="header-bar">
    <div class="header-left">
      <button class="ib burger" type="button" data-open="menu-drawer" aria-label="Open menu" aria-controls="menu-drawer">{% render 'icon', name: 'menu' %}</button>
      <ul class="nav" aria-label="Main">
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="sub">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 500 | image_tag: alt: shop.name, loading: 'eager', class: 'logo-img' }}
      {%- else -%}
        <img class="logo-img" src="{{ 'logo-mark.png' | asset_url }}" alt="{{ shop.name | escape }}" width="386" height="562" loading="eager">
      {%- endif -%}
    </a>

    <div class="header-icons">
      <button class="ib" type="button" data-open="search-modal" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="ib account-link" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <button class="ib" type="button" data-open="cart-drawer" aria-label="Open bag" aria-controls="cart-drawer">
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<aside class="drawer drawer--left" id="menu-drawer" aria-label="Menu" aria-hidden="true">
  <div class="drawer-head"><h3>Menu</h3><button class="ib" type="button" data-close aria-label="Close">{% render 'icon', name: 'close' %}</button></div>
  <div class="drawer-body">
    <ul class="mobile-nav">
      {%- for link in menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}<ul>{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
        </li>
      {%- endfor -%}
      {%- if shop.customer_accounts_enabled -%}
        <li><a href="{{ routes.account_url }}">{% if customer %}Account{% else %}Log in{% endif %}</a></li>
      {%- endif -%}
    </ul>
  </div>
</aside>

<div class="modal" id="search-modal" role="dialog" aria-label="Search" aria-hidden="true">
  <div class="modal-box">
    <button class="ib" type="button" data-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    <p class="eyebrow">Search</p>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search candles" aria-label="Search candles" autocomplete="off">
      <input type="hidden" name="type" value="product,article,page">
      <button type="submit" aria-label="Search">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
