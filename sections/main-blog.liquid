{%- paginate blog.articles by section.settings.per_page -%}
<section class="section">
  <div class="container">
    <div class="center"><span class="eyebrow">Journal</span><h1>{{ blog.title }}</h1></div>
    {%- if blog.all_tags.size > 0 -%}
      <div class="active-filters tag-row">
        <a class="chip{% unless current_tags %} on{% endunless %}" href="{{ blog.url }}">All</a>
        {%- for tag in blog.all_tags -%}<a class="chip{% if current_tags contains tag %} on{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
    {%- if blog.articles.size > 0 -%}
      <div class="product-grid" style="--cols:3">
        {%- for article in blog.articles -%}
          <article class="post">
            <a class="media media--3x2 zoom" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 960px) 33vw, 100vw', alt: article.image.alt }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'media-placeholder' }}{%- endif -%}
            </a>
            <p class="post-meta">{{ article.published_at | time_tag: format: 'date' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
            <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
            <a class="link-arrow" href="{{ article.url }}">Read{% render 'icon', name: 'arrow' %}</a>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state"><h2>Coming soon</h2><p class="muted" style="margin-inline:auto">Rituals and notes from the Maison are on their way.</p></div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [ { "type": "range", "id": "per_page", "label": "Posts per page", "min": 3, "max": 24, "step": 3, "default": 9 } ] }
{% endschema %}
