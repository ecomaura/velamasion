<section class="section bg-{{ section.settings.bg }}">
  <div class="container">
    <div class="center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="revs">
      {%- for block in section.blocks -%}
        <figure class="rev" {{ block.shopify_attributes }}>
          <div class="stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <figcaption><b>{{ block.settings.name }}</b><em>{{ block.settings.product }}</em></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kind words" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "select", "id": "bg", "label": "Background", "default": "alt", "options": [
      { "value": "ivory", "label": "Ivory" }, { "value": "alt", "label": "Deeper ivory" } ] }
  ],
  "blocks": [
    {
      "type": "review", "name": "Review", "limit": 6,
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "It changed how my evenings feel. The room is warmer the moment it is lit." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "product", "label": "Product", "default": "Amber" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
